#! /usr/bin/env bash
# shellcheck disable=SC2034

# Regular
blk='\e[0;30m' # Black - Regular
red='\e[0;31m' # Red
grn='\e[0;32m' # Green
ylw='\e[0;33m' # Yellow
blu='\e[0;34m' # Blue
pur='\e[0;35m' # Purple
cyn='\e[0;36m' # Cyan
wht='\e[0;37m' # White

# Bold
bblk='\e[1;30m'  # Black
bred='\e[1;31m'  # Red
bgrn='\e[1;32m'  # Green
bylw='\e[1;33m'  # Yellow
bblu='\e[1;34m'  # Blue
bpur='\e[1;35m'  # Purple
bcyn='\e[1;36m'  # Cyan
bwht='\e[1;37m'  # White

# Underline
ublk='\e[4;30m' # Black
ured='\e[4;31m' # Red
ugrn='\e[4;32m' # Green
uylw='\e[4;33m' # Yellow
ublu='\e[4;34m' # Blue
upur='\e[4;35m' # Purple
ucyn='\e[4;36m' # Cyan
uwht='\e[4;37m' # White

# Background
bgblk='\e[40m'   # Black
bgred='\e[41m'   # Red
bggrn='\e[42m'   # Green
bgylw='\e[43m'   # Yellow
bgblu='\e[44m'   # Blue
bgpur='\e[45m'   # Purple
bgcyn='\e[46m'   # Cyan
bgwht='\e[47m'   # White

clr='\e[0m'     # Text Reset

