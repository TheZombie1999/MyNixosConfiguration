layout {
    top_bar {
        height 1
        # Weitere Optionen für den oberen Balken können hier eingefügt werden
    }
    pane {
        command "bash"
        args "-i" "-c" "yy"
    }
    swap_tiled_layout {
        tab exact_panes=2 {
            pane split_direction="vertical" {
                pane {
                    command "bash"
                    args "-i" "-c" "yy"
                }
                pane
            }
        }
        tab min_panes=3 {
            pane split_direction="vertical" {
                pane {
                    command "bash"
                    args "-i" "-c" "yy"
                    size "20%"
                }
                pane stacked=true {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    bottom_bar {
        height 1
        # Weitere Optionen für den unteren Balken können hier eingefügt werden
    }
}
