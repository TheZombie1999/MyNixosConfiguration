
# Reach nixos-onedev from the internet via the hetzner-nbg1 jump bastion,
# using the YubiKey PIV authentication key for both hops.
Host nixos-onedev-wan
	User tim
	Hostname 192.168.178.103
	ProxyJump jump@hetzner.nixhomelab.de
	PKCS11Provider /nix/store/f9yy5vs1ldjr4bk0n6fb14gh2rd7ivcc-system-path/lib/libykcs11.so
