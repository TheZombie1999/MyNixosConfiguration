
Include ssh_configs.d/*

Host *
	Compression yes
	ForwardX11 no
	TCPKeepAlive yes
	ServerAliveInterval 20
	ServerAliveCountMax 3
	ConnectTimeout 2m
	StrictHostKeyChecking no
	UserKnownHostsFile ~/.ssh/known_hosts
	HashKnownHosts no
	ControlMaster auto
	ControlPath ~/.ssh/control/cm%r@%h:%p
	ControlPersist yes
	LogLevel ERROR
	

