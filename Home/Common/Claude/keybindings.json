{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "alt+j": "scroll:pageDown",
        "alt+k": "scroll:pageUp",
        "alt+n": "scroll:pageDown",
        "alt+p": "scroll:pageUp"
      }
    }
  ]
}
