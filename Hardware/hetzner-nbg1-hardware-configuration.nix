{
  lib,
  modulesPath,
  ...
}:

{
  imports = [ (modulesPath + "/profiles/qemu-guest.nix") ];

  boot.initrd.availableKernelModules = [
    "ahci"
    "xhci_pci"
    "virtio_pci"
    "virtio_scsi"
    "sd_mod"
    "sr_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/7fdc94b2-f1f8-4cd1-85ce-03ee72e9e074";
    fsType = "ext4";
  };

  # Hetzner Cloud's ESP is mounted at /boot/efi (not the NixOS-default /boot) --
  # must match boot.loader.efi.efiSysMountPoint in the machine config.
  fileSystems."/boot/efi" = {
    device = "/dev/disk/by-uuid/E079-7D41";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
